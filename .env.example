GEMINI_API_KEY=your_gemini_api_key_here

# Optional but recommended — logging in makes Instaloader far less likely
# to get rate-limited or blocked by Instagram. Use a throwaway/secondary
# account, not your main one.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Optional — only needed if your Obsidian vault isn't at
# ~/Documents/Obsidian Vault. Used by the "Save to Content Radar" button.
# Leave unset when hosting this remotely (there's no vault to reach) — the
# UI detects this via /config and disables the Save button automatically.
VAULT_PATH=

# Set BOTH of these before deploying anywhere public. When set, every route
# requires this username/password via the browser's built-in Basic Auth
# prompt. Leave both unset for local-only use (no login prompt, same as
# before). Required in production because this app spends your Gemini quota
# and logs into Instagram on every request.
ANALYZER_USERNAME=
ANALYZER_PASSWORD=
